# Playwright Configuration Environment Variables
# Copy this file to .env and customize for your project

# Base URL for web projects (uncomment and set if testing web applications)
# BASE_URL=http://localhost:3000

# Run tests in headless mode (true/false)
# Set to false for VSCode debugging with visible browser
HEADLESS=false

# Add delay between actions in milliseconds (useful for debugging)
# SLOW_MO=100

# API Base URL for API testing projects
# API_BASE_URL=http://localhost:8080/api

# Custom Playwright configuration
# PWDEBUG=console

# CI mode (automatically set in CI environments)
# CI=true

# Knowledgebase (pgvector)
# PostgreSQL connection string for centralized knowledgebase
# These settings are OPTIONAL — all features gracefully degrade when not configured.
# For manual database setup, see: scripts/knowledgebase-init.sql
DATABASE_URL=postgresql://postgres:9ssoRqFymJv8LL+melwCfJoB5Sr6q2JC@192.168.31.200:5432/postgres

# OpenAI API key for higher-quality embeddings (optional — falls back to local @xenova/transformers)
# OPENAI_API_KEY=sk-...
