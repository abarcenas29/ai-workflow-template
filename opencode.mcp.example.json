{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.project.md"],
  "agents": {
    "architect": { "model": "deepseek/deepseek-flash" },
    "coder": { "model": "deepseek/deepseek-flash" },
    "deployer": { "model": "deepseek/deepseek-flash" },
    "designer": { "model": "deepseek/deepseek-flash" },
    "e2e-tester": { "model": "deepseek/deepseek-flash" },
    "implementer": { "model": "deepseek/deepseek-flash" },
    "orchestrator/feature-pipeline": { "model": "deepseek/deepseek-flash" },
    "orchestrator/orchestrator": { "model": "deepseek/deepseek-flash" },
    "orchestrator/tdd-orchestrator": { "model": "deepseek/deepseek-flash" },
    "planner": { "model": "deepseek/deepseek-flash" },
    "researcher": { "model": "deepseek/deepseek-flash" },
    "reviewer": { "model": "deepseek/deepseek-flash" },
    "scope": { "model": "deepseek/deepseek-flash" },
    "tracker": { "model": "deepseek/deepseek-flash" },
    "unit-tester": { "model": "deepseek/deepseek-flash" }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true
    },
    "angular-cli": {
      "type": "local",
      "command": ["npx", "-y", "@angular/cli", "mcp"],
      "enabled": true
    },
    "ddg-search": {
       "type": "local",
       "command": ["npx", "-y", "ddg-mcp-search"],
       "enabled": true
     },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_TOKEN}"
      },
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["node", "scripts/mcp/playwright-mcp-launcher.js"],
      "environment": {
        "HEADLESS": "{env:HEADLESS}",
        "SLOW_MO": "{env:SLOW_MO}",
        "VIEWPORT": "{env:VIEWPORT}"
      },
      "timeout": 120000,
      "enabled": true
    },
    "playwright-firefox": {
      "type": "local",
      "command": ["node", "scripts/mcp/playwright-mcp-launcher.js"],
      "environment": {
        "BROWSER": "firefox",
        "ISOLATED": "true",
        "HEADLESS": "{env:HEADLESS}",
        "VIEWPORT": "{env:VIEWPORT}"
      },
      "timeout": 120000,
      "enabled": true
    },
    "example-server": {
      "type": "local",
      "command": ["npx", "-y", "your-mcp-package"],
      "enabled": false
    },
    "example-remote": {
      "type": "remote",
      "url": "https://your-mcp-server.com/mcp",
      "enabled": false
    },
    "memory-bank": {
      "type": "local",
      "command": ["node", "scripts/mcp-memory-server.js"],
      "enabled": true
    }
  },
  "plugins": [
    "@tarquinen/opencode-dcp@3.2.0"
  ],
  "permission": {
    "ddg-search_*": "allow",
    "github_*": "allow",
    "mcp-everything_*": "allow",
    "angular-cli_*": "allow",
    "playwright_*": "allow",
    "playwright-firefox_*": "allow",
    "context7_*": "allow",
    "memory-bank_*": "allow"
  }
}
